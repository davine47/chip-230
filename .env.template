# ============================================================
# 复制成 .env 后填写；.env 已被 .gitignore 忽略，不会误提交
#     cp .env.example .env
# ============================================================

# ---------- 控制面：阿里云 AccessKey（调 OpenAPI 用）----------
# 建议用 RAM 子账号，并附加 AliyunKvstoreReadOnlyAccess（只读够演示用）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 实例所在地域，例如 cn-hangzhou / cn-beijing / cn-shanghai
ALIBABA_CLOUD_REGION_ID=cn-hangzhou

# 一般留空，SDK 会按地域自动解析 endpoint；
# 只有在特殊网络环境（代理/专线）才需要手动指定
# ALIBABA_CLOUD_ENDPOINT=r-kvstore.aliyuncs.com

# 可选：固定操作某个实例，01/03 会优先用它
# TAIR_INSTANCE_ID=r-bp1xxxxxxxxxxxx

# ---------- 数据面：Redis 连接信息（读写数据用）----------
# 控制台「连接信息」里的连接地址；本机调试需要公网地址
REDIS_HOST=
REDIS_PORT=6379
# 实例密码；如果是 6.0 的自定义账号，还需要填用户名
REDIS_PASSWORD=
# REDIS_USERNAME=
# 集群架构只支持 db 0
REDIS_DB=0
# 实例开启了 TLS 加密连接时改为 true
REDIS_SSL=false

# ---------- 对象存储 OSS（可选，跑 04_oss_demo.py 用）----------
# 不填 OSS_BUCKET 时会自动取当前地域的第一个 bucket
OSS_BUCKET=
# 不填则沿用 ALIBABA_CLOUD_REGION_ID
OSS_REGION=
# 不填则按地域自动拼 oss-{region}.aliyuncs.com；内网用 oss-{region}-internal.aliyuncs.com
# OSS_ENDPOINT=
# 演示对象都写在这个前缀下，方便一眼认出和清理
OSS_PREFIX=chip-230-demo/
# 看板「文档库」上传的文件放这里
OSS_DOCS_PREFIX=agents/docs/
# 看板「Plan 库」上传的计划文件放这里
OSS_PLANS_PREFIX=plans/

# ---------- 表格存储 Tablestore（可选，跑 05_tablestore_demo.py 用）----------
OTS_INSTANCE=
OTS_TABLE=oss_documents
# 留空则按 https://{OTS_INSTANCE}.{region}.ots.aliyuncs.com 拼
# OTS_ENDPOINT=
